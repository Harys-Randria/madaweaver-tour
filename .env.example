# ============================================================================
#  Variables d'environnement — Madaweaver Tour
#  Copiez ce fichier en « .env.local » et remplissez avec VOS clés Supabase.
#  (Supabase → Project Settings → API → Project URL + anon public key)
#  Tant que ces valeurs sont absentes, le site tourne sur les données locales.
# ============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=VOTRE_CLE_ANON_PUBLIQUE

# ----------------------------------------------------------------------------
#  Envoi des emails du formulaire de contact (Resend) — OPTIONNEL.
#  Sans cette clé, le formulaire retombe sur WhatsApp / le logiciel mail.
#  (resend.com → API Keys → Create API Key)
# ----------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Une fois VOTRE domaine vérifié sur Resend, personnalisez l'expéditeur :
# RESEND_FROM=Madaweaver Tour <contact@votre-domaine.com>
